# Get a free Web3Forms access key at https://web3forms.com
# Enter your email and click create. They'll send you a key in ~1 minute.
#
# Setup:
# 1. Copy this file to .env.local
# 2. Paste your access key below
# 3. Run `npm run dev` — the newsletter form will now work

VITE_WEB3FORMS_ACCESS_KEY=your_access_key_here
